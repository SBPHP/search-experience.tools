# --- Fallback tool access & permission filter ---
def __skip_get_tools():
    # Bevorzugt Session-Tools (falls dynamisch geladen), sonst statisch TOOLS
    tools = st.session_state.get("tools")
    if isinstance(tools, list) and tools:
        return tools
    try:
        return TOOLS
    except NameError:
        return []

def filter_tools(tools_list):
    # Rollen & erlaubte Tools aus der Session (werden nach Login gesetzt)
    roles = st.session_state.get("user_roles") or set()
    allowed = st.session_state.get("allowed_tools")

    # Admin sieht alles
    if isinstance(roles, (set, list)) and "admin" in roles:
        return tools_list

    # Wildcard -> alles
    if allowed == "*" or (isinstance(allowed, list) and "*" in allowed):
        return tools_list

    # Keine Restriktionen bekannt -> alles anzeigen (kein Lockout)
    if not allowed:
        return tools_list

    keep = set(allowed if isinstance(allowed, list) else [allowed])
    return [t for t in tools_list if t.get("slug") in keep]



# --- robust check_health: systemd zuerst, dann HTTP (2xx/3xx), HEAD→GET ---
def check_health(port: int, slug: str, timeout: float = 2.0):
    """
    Zeigt 'UP', wenn:
      1) systemd den Service als active meldet ODER
      2) ein Health-Endpoint 2xx/3xx liefert (BaseUrlPath wird berücksichtigt).
    Gibt (ok: bool, latency_ms: float) zurück.
    """
    import time as _t, subprocess, shutil
    start = _t.perf_counter()

    # 1) systemd-Fallback (schnell + robust)
    ok_sys = False
    try:
        unit = {
            "metadatacreator": "se-metadatacreator.service",
            "redirectmapper":  "se-redirectmapper.service",
            "linkchecker":     "se-linkchecker.service",
            "contentgapper":   "se-contentgapper.service",
        }.get(slug)
        if unit and shutil.which("systemctl"):
            out = subprocess.check_output(["systemctl","is-active",unit], text=True, timeout=1.5).strip()
            ok_sys = (out == "active")
    except Exception:
        ok_sys = False

    # 2) HTTP-Health (inkl. BaseUrlPath)
    ok_http = False
    try:
        import requests
        # Tool-Record (session_state.tools > TOOLS)
        tool = None
        try:
            for t in (st.session_state.get("tools") or []):
                if t.get("slug") == slug:
                    tool = t; break
        except Exception:
            pass
        if tool is None:
            try:
                for t in TOOLS:
                    if t.get("slug") == slug:
                        tool = t; break
            except Exception:
                pass
        tool = tool or {}

        urls = []
        u = (tool.get("health_url") or "").strip()
        if u:
            urls.append(u)
        hp = (tool.get("health_path") or "").strip()
        if hp:
            urls.append(f"http://127.0.0.1:{port}{hp}")

        # Standardpfade (auch BaseUrlPath-Variante)
        urls += [
            f"http://127.0.0.1:{port}/_stcore/health",
            f"http://127.0.0.1:{port}/healthz",
            f"http://127.0.0.1:{port}/tools/{slug}/_stcore/health",
            f"http://127.0.0.1:{port}/",
        ]

        # Dedupe
        seen, uniq = set(), []
        for x in urls:
            if x and x not in seen:
                uniq.append(x); seen.add(x)

        def _probe(url: str) -> int:
            try:
                r = requests.head(url, timeout=timeout, allow_redirects=False)
                if 200 <= r.status_code < 400:
                    return r.status_code
            except Exception:
                pass
            try:
                r = requests.get(url, timeout=timeout, allow_redirects=True)
                return r.status_code
            except Exception:
                return 0

        for url in uniq:
            code = _probe(url)
            if 200 <= code < 400:
                ok_http = True
                break
    except Exception:
        ok_http = False

    ok = ok_sys or ok_http
    latency_ms = (_t.perf_counter() - start) * 1000.0
    return ok, latency_ms

# --- Ende robust check_health ---

