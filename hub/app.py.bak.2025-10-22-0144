def find_tool(slug: str):
    """Tool-Record nach slug aus der TOOLS-Liste oder anderen Quellen ermitteln."""
    try:
        for t in TOOLS:
            if t.get("slug") == slug:
                return t
    except Exception:
        pass
    # Fallback: evtl. dynamische Quelle in st.session_state
    try:
        for t in st.session_state.get("tools", []):
            if t.get("slug") == slug:
                return t
    except Exception:
        pass
    return {}


def _resolve_health_urls(port: int, slug: str) -> list:
    """Baue die Liste möglicher Health-URLs – inkl. tool-spezifischen Overrides."""
    urls = []
    t = find_tool(slug) or {}

    # Harte URL (überschreibt alles)
    u = (t.get("health_url") or "").strip()
    if u:
        urls.append(u if u.startswith("http") else f"http://127.0.0.1:{port}{u}")

    # Relativer Pfad
    hp = (t.get("health_path") or "").strip()
    if hp:
        urls.append(f"http://127.0.0.1:{port}{hp}")

    # Defaults (Streamlit)
    urls.extend([
        f"http://127.0.0.1:{port}/_stcore/health",
        f"http://127.0.0.1:{port}/healthz",
