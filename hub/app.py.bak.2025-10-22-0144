# Cache-Helper: leert Cache der neuesten Health-Impl, sonst globalen cache_data
def clear_health_cache():
    for fn_name in ("_check_health_v4", "_check_health_v3", "check_health", "check_health_legacy"):
        try:
            fn = globals().get(fn_name)
            if fn and hasattr(fn, "clear"):
                fn.clear()
                return
        except Exception:
            pass
    try:
        # Fallback: gesamten cache_data leeren
        st.cache_data.clear()
    except Exception:
        pass


