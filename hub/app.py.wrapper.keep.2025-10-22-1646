# ================= Fallback-Dashboard (immer sichtbar) =================
def run(cmd, timeout=10):
    return subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout)

def unit_status(unit: str) -> str:
    p = run(["systemctl", "is-active", unit])
    return (p.stdout or p.stderr).strip()

def unit_action(unit: str, action: str):
    p = run(["systemctl", action, unit])
    ok = p.returncode == 0
    msg = (p.stdout or p.stderr).strip() or f"{unit} {action}"
    return ok, msg

def health_local(port: int, path: str):
    hp = f"/{path}/_stcore/health" if path else "/_stcore/health"
    try:
        p = run(["curl", "-sS", "-o", "/dev/null", "-w", "%{http_code}", f"http://127.0.0.1:{port}{hp}"], timeout=5)
        return (p.stdout.strip() == "200", f"HTTP {p.stdout.strip()}")
    except Exception as e:
        return False, f"err: {e}"

def badge(ok: bool) -> str:
    return "🟢 OK" if ok else "🔴 DOWN"

