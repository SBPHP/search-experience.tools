def _ctl(action: str, slug: str) -> tuple[bool,str]:
    # nutzt dein streamlit-toolctl, wenn vorhanden
    try:
        ok, out = run_ctl([action, slug])
        return (bool(ok), str(out))
    except Exception as e:
        return (False, f"ctl fehlgeschlagen: {e}")

