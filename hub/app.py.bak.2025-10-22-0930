# -------- Utils --------
def status_badge(up: bool, latency_ms: float) -> str:
    color = "#22c55e" if up else "#ef4444"
    label = "UP" if up else "DOWN"
    lat   = f"{latency_ms:.0f}ms" if latency_ms > 0 else "—"
    return (
        f'<span style="display:inline-flex;align-items:center;gap:.35rem;'
        f'padding:.1rem .55rem;border-radius:999px;background:{color}1A;'
        f'color:{color};font-weight:700;font-size:.78rem;">● {label} · {lat}</span>'
    )

def run_ctl(action: str, slug: str) -> tuple[bool, str]:
    """start/stop/restart/status via /usr/local/bin/streamlit-toolctl (optional)."""
    bin_path = "/usr/local/bin/streamlit-toolctl"
    if not os.path.exists(bin_path) or not os.access(bin_path, os.X_OK):
        return False, "toolctl nicht vorhanden (optional)"
    try:
        out = subprocess.check_output([bin_path, action, slug], text=True, stderr=subprocess.STDOUT, timeout=8)
        return True, out.strip()
    except subprocess.CalledProcessError as e:
        return False, (e.output or f"Exit {e.returncode}").strip()
    except Exception as e:
        return False, str(e)

@st.cache_data(ttl=1, show_spinner=False)
def check_health(port: int, slug: str, timeout: float = 1.8) -> tuple[bool, float]:
    """Robuster Health-Check:
       1) systemd is-active (wenn möglich)
       2) HTTP-HEAD → HTTP-GET (2xx/3xx = OK), inkl. spezieller health_path.
    """
    t0 = time.perf_counter()
    ok = False

    # 1) systemd
    try:
        unit = {
            "metadatacreator": "se-metadatacreator.service",
            "redirectmapper":  "se-redirectmapper.service",
            "linkchecker":     "se-linkchecker.service",
            "contentgapper":   "se-contentgapper.service",
            "hub":             "search-experience-hub.service",
        }.get(slug)
        if unit and shutil.which("systemctl"):
            out = subprocess.check_output(["systemctl", "is-active", unit], text=True, timeout=1.2).strip()
            if out == "active":
                ok = True
    except Exception:
        pass

    # 2) HTTP Health (wenn requests da ist oder systemd nicht already OK)
    urls = []
    # tool-spezifisch:
    tp = next((t for t in TOOLS if t.get("slug")==slug), {})
    hp = (tp.get("health_path") or "").strip()
    if hp:
        urls.append(f"http://127.0.0.1:{port}{hp}")
    # default-Pfade:
    urls += [
        f"http://127.0.0.1:{port}/_stcore/health",
        f"http://127.0.0.1:{port}/healthz",
        f"http://127.0.0.1:{port}/",
    ]
    seen, uniq = set(), []
    for u in urls:
        if u not in seen:
            uniq.append(u); seen.add(u)

    if not ok and requests is not None:
        def _probe(url: str) -> int:
            try:
                r = requests.head(url, timeout=timeout, allow_redirects=False)
                if 200 <= r.status_code < 400: return r.status_code
            except Exception:
                pass
            try:
                r = requests.get(url, timeout=timeout, allow_redirects=False)
                return r.status_code
            except Exception:
                return 0
        for u in uniq:
            code = _probe(u)
            if 200 <= code < 400:
                ok = True
                break

    lat = (time.perf_counter() - t0) * 1000.0
    return ok, lat

