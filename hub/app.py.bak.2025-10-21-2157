def filter_tools(tools_list: List[Dict]) -> List[Dict]:
    if "*" in allowed_list or "admin" in user_roles:
        return tools_list
    keep = set([t.strip() for t in allowed_list])
    return [t for t in tools_list if t.get("slug") in keep]

