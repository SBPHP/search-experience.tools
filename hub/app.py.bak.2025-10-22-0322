# ===== Auth Helper (rückwärts-kompatibel zur aktuellen streamlit_authenticator-Version) =====
def _do_auth_safe():
    """
    Login-Wrapper für streamlit_authenticator:
    - Ruft authenticator.login("sidebar") auf (liefert bei deiner Version nichts zurück)
    - Liest name/username/authentication_status aus st.session_state
    - Gibt (name, username, auth_state, auth) zurück
    """
    import streamlit as st
    try:
        import streamlit_authenticator as stauth
    except Exception as e:
        st.error(f"Auth-Modul fehlt: {e}")
        st.stop()

    # cfg wird global vorausgesetzt (dein Dict mit credentials & cookie)
    cfg = globals().get("cfg") or {}
    creds = cfg.get("credentials", {}) or {}
    cookie = cfg.get("cookie", {}) or {}
    cookie_name = cookie.get("name", "se_auth")
    cookie_key  = cookie.get("key",  "se_key")
    cookie_days = int(cookie.get("expiry_days", 7))

    auth = stauth.Authenticate(
        credentials=creds,
        cookie_name=cookie_name,
        key=cookie_key,
        cookie_expiry_days=cookie_days,
    )

    # NICHT entpacken – bei deiner Version setzt login() nur session_state
    with st.sidebar:
        try:
            auth.login("sidebar")
        except Exception as e:
            st.error(f"Login-Fehler: {e}")

    name = st.session_state.get("name")
    username = st.session_state.get("username")
    auth_state = st.session_state.get("authentication_status")
    return name, username, auth_state, auth
