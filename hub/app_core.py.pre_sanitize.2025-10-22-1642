def _read_logs(unit: str, lines: int = 80) -> str:
    import subprocess
    try:
        out = subprocess.check_output(
            ["journalctl", "-u", unit, "-n", str(lines), "--no-pager"],
            text=True, timeout=3
        )
        return out
