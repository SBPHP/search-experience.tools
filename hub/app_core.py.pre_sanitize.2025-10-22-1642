def seo_quick_audit(url: str) -> dict:
    import re, time
    try:
        import requests
    except Exception:
        requests = None

    res = {"ok": False, "status": 0, "latency_ms": 0.0,
           "title": "", "h1": "", "canonical": "", "robots": ""}

    if not url: 
        return res

    if not re.match(r"^https?://", url):
        url = "https://" + url

    t0 = time.perf_counter()
    try:
        if requests:
            r = requests.get(url, timeout=5, headers={"User-Agent": "SE-Hub/quick-audit"})
            res["status"] = r.status_code
            html = r.text if isinstance(r.text, str) else ""
        else:
            import urllib.request
            with urllib.request.urlopen(url, timeout=5) as r:
                res["status"] = getattr(r, "status", 200)
                html = r.read().decode("utf-8", "ignore")
        res["ok"] = 200 <= int(res["status"]) < 400
        res["latency_ms"] = (time.perf_counter() - t0) * 1000.0
    except Exception:
        res["latency_ms"] = (time.perf_counter() - t0) * 1000.0
        return res

    # sehr einfache Extraktion
    def rx(pat, s):
        m = re.search(pat, s, re.I|re.S)
        return (m.group(1).strip() if m else "")

    res["title"]    = rx(r"<title[^>]*>(.*?)</title>", html)
    res["h1"]       = rx(r"<h1[^>]*>(.*?)</h1>", html)
    res["canonical"]= rx(r'<link[^>]+rel=["\']canonical["\'][^>]+href=["\']([^"\']+)["\']', html)
    res["robots"]   = rx(r'<meta[^>]+name=["\']robots["\'][^>]+content=["\']([^"\']+)["\']', html)
    return res

