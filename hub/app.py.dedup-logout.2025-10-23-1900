@st.cache_data(ttl=1, show_spinner=False)
def _check_health_v3(port: int, slug: str, timeout: float = 1.8):
    """2xx–3xx = UP. Bevorzugt health_url, dann health_path, dann Default-Pfade. HEAD→GET-Fallback."""
    import time as _t
    start = _t.perf_counter()

    # Tool-Record finden: zuerst session_state.tools, dann TOOLS
    tool = None
    try:
        for t in (st.session_state.get("tools") or []):
            if t.get("slug") == slug:
                tool = t
                break
    except Exception:
        pass
    if tool is None:
        try:
            for t in TOOLS:
                if t.get("slug") == slug:
                    tool = t
                    break
        except Exception:
            pass
    tool = tool or {}

    urls = []

    # 1) absolute URL aus tool (bevorzugt)
    u = (tool.get("health_url") or "").strip()
    if u:
        urls.append(u)

    # 2) relativer health_path → absolut machen
    hp = (tool.get("health_path") or "").strip()
    if hp:
        urls.append(f"http://127.0.0.1:{port}{hp}")

    # 3) Standard-Streamlit-Pfade
    urls += [
        f"http://127.0.0.1:{port}/_stcore/health",
        f"http://127.0.0.1:{port}/healthz",
        f"http://127.0.0.1:{port}/",
    ]

    # Dedupe mit Reihenfolge
    seen, uniq = set(), []
    for x in urls:
        if x not in seen:
            uniq.append(x); seen.add(x)

    # Probe: erst HEAD (schnell). Wenn nicht 2xx/3xx, dann GET.
    def _probe(url: str) -> int:
        try:
            r = requests.head(url, timeout=timeout, allow_redirects=False)
            if 200 <= r.status_code < 400:
                return r.status_code
        except Exception:
            pass
        try:
            r = requests.get(url, timeout=timeout, allow_redirects=False)
            return r.status_code
        except Exception:
            return 0

    ok = False
    for url in uniq:
        code = _probe(url)
        if 200 <= code < 400:
            ok = True
            break

    latency_ms = (_t.perf_counter() - start) * 1000.0
    return ok, latency_ms

