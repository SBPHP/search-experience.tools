def _render_client_logout(base_href: str = "/tools"):
    """
    Client-seitiger Logout:
      - löscht ALLE Cookies (mehrere Pfad-/Domain-Varianten)
      - leert localStorage/sessionStorage
      - redirect auf base_href (Login-Seite deines Hubs)
    """
    import uuid
    _nonce = uuid.uuid4().hex  # Cachebust
    st.markdown(f"""
<script>
(function() {{
  try {{
    // Alle Cookies einlesen
    const raw = document.cookie || "";
    const parts = raw.split(';').map(c => c.trim()).filter(Boolean);
    // Kandidaten-Domain/Pfad-Kombis durchprobieren
    const domains = [window.location.hostname, "."+window.location.hostname.replace(/^\\./,"")];
    const paths = ["/", "/tools", "/tools/"];
    const past = "Thu, 01 Jan 1970 00:00:00 GMT";

    function del(name) {{
      try {{
        // ohne Domain
        document.cookie = name + "=; expires=" + past + "; path=/";
        // mit Domains & Paths
        domains.forEach(d => {{
          paths.forEach(p => {{
            document.cookie = name + "=; expires=" + past + "; path=" + p + "; domain=" + d;
          }});
        }});
      }} catch(e) {{}}
    }}

    parts.forEach(p => {{
      const name = p.split('=')[0];
      if(name) del(name);
    }});

    // Storage löschen
    try {{ localStorage.clear(); }} catch(e) {{}}
    try {{ sessionStorage.clear(); }} catch(e) {{}} 

    // kleine Verzögerung, dann redirect
    setTimeout(function(){{
      const target = (base_href || "/");
      // immer harter Reload (Cachebust)
      const u = target + (target.includes("?") ? "&" : "?") + "logout=" + "{_nonce}";
      window.location.href = u;
    }}, 80);
  }} catch(e) {{
    // Fallback-Redirect
    window.location.href = (base_href || "/");
  }}
}})();
</script>
    """, unsafe_allow_html=True)


def _perform_logout():
    """
    Harter Logout:
      - Auth-Objekt (streamlit-authenticator) resetten + Cookies löschen (best effort)
      - Session-Keys & Caches leeren
      - Query-Params aufräumen
      - Rerun -> Login-Maske
    """
    # 1) Authenticator-Cookies/State (best effort)
    _auth = (st.session_state.get("AUTHENTICATOR")
             or st.session_state.get("authenticator")
             or st.session_state.get("auth"))
    try:
        # bekannte Session-Keys des Authenticators/Apps
        for k in (
            "authentication_status","auth_status","authed",
            "name","username","user","roles"
        ):
            st.session_state.pop(k, None)

        # Cookie-Manager, falls vorhanden
        cm = getattr(_auth, "cookie_manager", None)
        if cm:
            # gängige Cookie-Namen versuchen zu löschen
            for c in (
                "_streamlit_authenticator","authentication_status","name","username","user"
            ):
                try: cm.delete(c)
                except Exception: pass

        # evtl. Reset-Methode
        if hasattr(_auth, "reset"):
            try: _auth.reset()
            except Exception: pass
    except Exception:
        pass

    # 2) Caches räumen
    try: st.cache_data.clear()
    except Exception: pass
    try: st.cache_resource.clear()
    except Exception: pass

    # 3) Query-Params leeren (neu) bzw. Fallback (alt)
    try:
        st.query_params.clear()
    except Exception:
        try: st.experimental_set_query_params()
        except Exception: pass

    # 4) explizit auf "nicht eingeloggt" setzen
    st.session_state["authentication_status"] = None
    st.session_state["authed"] = False

    # 5) harter rerun
    st.rerun()
