HEALTH_OVERRIDES = {
    # MetadataCreator läuft mit Base-Pfad → eigener Health-Pfad
    "metadatacreator": "/tools/metadatacreator/_stcore/health",
}

def _probe(url: str, timeout: float) -> int:
    """Gibt HTTP-Status zurück. Erst HEAD, wenn nicht 2xx/3xx → GET."""
    try:
        import requests as _rq
    except Exception:
        return 0
    code_head = 0
    try:
        r = _rq.head(url, timeout=timeout, allow_redirects=False)
        code_head = int(getattr(r, "status_code", 0)) or 0
        if 200 <= code_head < 400:
            return code_head
    except Exception:
        pass
    # Fallback GET – wenn HEAD nicht erfolgreich war
    try:
        r = _rq.get(url, timeout=timeout, allow_redirects=False)
        return int(getattr(r, "status_code", 0)) or 0
    except Exception:
        return code_head or 0

@st.cache_data(ttl=1, show_spinner=False)
def check_health_disabled(port: int, slug: str, timeout: float = 1.8):
    """2xx–3xx = UP. Nutzt optional tool-spezifische Health-Pfade."""
    import time as _t
    start = _t.perf_counter()

    # 1) Tool-spezifisch
    urls = []
    hp = HEALTH_OVERRIDES.get(slug)
    if hp:
        urls.append(f"http://127.0.0.1:{port}{hp}")

    # 2) Defaults
    urls += [
        f"http://127.0.0.1:{port}/_stcore/health",
        f"http://127.0.0.1:{port}/healthz",
        f"http://127.0.0.1:{port}/",
    ]

    # Dedupe bei Reihenfolge
    seen, uniq = set(), []
    for u in urls:
        if u not in seen:
            uniq.append(u); seen.add(u)

    ok = False
    for u in uniq:
        code = _probe(u, timeout)
        if 200 <= code < 400:
            ok = True
            break

    latency_ms = (_t.perf_counter() - start) * 1000.0
    return ok, latency_ms
