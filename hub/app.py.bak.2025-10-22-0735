# -----------------------------
# Health-Check (stabil & simpel)
# -----------------------------
@st.cache_data(ttl=1, show_spinner=False)
def check_health(port: int, slug: str, timeout: float = 1.8) -> Tuple[bool, float]:
    """2xx–3xx = UP. Erst HEAD (schnell), dann GET. Nutzt ggf. absolute health_url je Tool."""
    t0 = time.perf_counter()

    # Tool lookup
    tool = None
    for t in TOOLS:
        if t.get("slug") == slug:
            tool = t
            break
    tool = tool or {}

    urls: List[str] = []
    u = (tool.get("health_url") or "").strip()
    if u:
        urls.append(u)

    # Standard-Streamlit-Pfade als Fallback
    urls += [
        f"http://127.0.0.1:{port}/_stcore/health",
        f"http://127.0.0.1:{port}/healthz",
        f"http://127.0.0.1:{port}/",
    ]

    # Dedupe
    seen, uniq = set(), []
    for x in urls:
        if x and x not in seen:
            uniq.append(x); seen.add(x)

    if not requests:
        # ohne requests können wir keine echte Aussage treffen
        return False, (time.perf_counter() - t0) * 1000.0

    # Probe HEAD→GET
    ok = False
    for url in uniq:
        try:
            r = requests.head(url, timeout=timeout, allow_redirects=False)
            if 200 <= r.status_code < 400:
                ok = True
                break
        except Exception:
            pass
        try:
            r = requests.get(url, timeout=timeout, allow_redirects=False)
            if 200 <= r.status_code < 400:
                ok = True
                break
        except Exception:
            pass

    latency_ms = (time.perf_counter() - t0) * 1000.0
    return ok, latency_ms

def status_badge(up: bool, latency_ms: float) -> str:
    color = "#22c55e" if up else "#ef4444"
    label = "UP" if up else "DOWN"
    lat_s = f"{latency_ms:.0f}ms" if latency_ms else "—"
    return (
        f'<span style="display:inline-flex;align-items:center;gap:.35rem;'
        f'padding:.1rem .5rem;border-radius:999px;background:{color}1A;'
        f'color:{color};font-weight:700;font-size:.78rem;">● {label} · {lat_s}</span>'
    )

